# Google Gemini API Key
# Obtain free from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Default Model Selection (e.g., gemini-2.0-flash, gemini-1.5-flash)
VITE_GEMINI_MODEL=gemini-2.0-flash

# Loop Engineering Engine Configuration
VITE_LOOP_MAX_ITERATIONS=3
VITE_LOOP_GROUNDEDNESS_THRESHOLD=85
VITE_LOOP_READABILITY_TARGET_GRADE=8
